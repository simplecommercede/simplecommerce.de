# Interne PHP-Meldungen nie ausgeben; wirkt nur unter mod_php, sonst in der PHP-Konfiguration setzen.
<IfModule mod_php.c>
php_flag display_errors off
php_flag expose_php off
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
</FilesMatch>
Header always unset X-Powered-By
Header unset X-Powered-By
Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# Public help may be embedded by any shop. Forms and all other routes stay protected.
Header unset X-Frame-Options "expr=%{REQUEST_URI} =~ m#^/hilfe/#"
Header always unset X-Frame-Options "expr=%{REQUEST_URI} =~ m#^/hilfe/#"
Header always set Content-Security-Policy "frame-ancestors 'self' http: https:" "expr=%{REQUEST_URI} =~ m#^/hilfe/#"
</IfModule>

# PHP-Konfiguration und interne Laufzeitdateien niemals ausliefern.
<FilesMatch "^(\.user\.ini|.*\.(log|jsonl))$">
Require all denied
</FilesMatch>
